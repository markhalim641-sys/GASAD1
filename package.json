{
  "name": "jasad-wahed-church-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "seed": "node server/seed.js --reset",
    "seed:accounts": "node server/seed-accounts.js",
    "test:prep": "node --test server/tests/preparations.test.mjs",
    "test:att": "node --test server/tests/attendance.test.mjs",
    "test:wh": "node --test server/tests/warehouse.test.mjs",
    "test": "node --test --test-concurrency=1 server/tests/preparations.test.mjs server/tests/warehouse.test.mjs server/tests/attendance.test.mjs",
    "prod": "npm run build && concurrently -n api,web -c yellow,green \"npm:server\" \"npm:preview\"",
    "dev:all": "concurrently -n api,web -c yellow,green \"npm:server\" \"npm:dev\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.11.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.27.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
